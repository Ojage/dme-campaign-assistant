{
  "name": "dme-campaigns-ojage-fe",
  "version": "0.1.0",
  "private": true,
  "description": "Campaign Assistant — internal marketing workspace for DME.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @dme/web dev",
    "dev:web": "pnpm --filter @dme/web dev",
    "dev:api": "pnpm --filter @dme/api dev",
    "build": "pnpm --filter @dme/web build",
    "preview": "pnpm --filter @dme/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean"
  }
}
