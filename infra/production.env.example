# Production environment for the DME Campaign Assistant.
#
# Copy these keys into the `DME_CAMPAIGN_ENV` GitHub secrets value. Required
# keys that are left empty below will make `docker compose config` refuse to
# start, so fill POSTGRES_PASSWORD, both JWT secrets and the provider key
# before deploying.
#
#   fill_value=$(openssl rand -hex 32)
#   Docker Desktop / Docker Hub (or any other channel) can hold the secret.
#
# Values can also be set directly in the VPS copy of .env: deploy preserves
# any key that is not present in the CI secret (see scripts/ci-deploy.sh).

# --- Hostnames ---------------------------------------------------------------
# The web origin and the public API host are served by NNACT Pro's Caddy on the
# shared VPS; create the two A records pointing at that server.
CAMPAIGN_SITE_ADDRESS=campaign.ojage.org
CAMPAIGN_API_ADDRESS=api.campaign.ojage.org

# --- Database ----------------------------------------------------------------
POSTGRES_USER=campaigns
POSTGRES_DB=campaigns
# Required.
POSTGRES_PASSWORD=

# --- Authentication ----------------------------------------------------------
# Required; at least 16 characters. Different values from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- Content model -----------------------------------------------------------
# One of the two keys below must be set, or the deploy refuses to run: without a
# provider, generation would silently fall back to the offline scripted copy.
# `auto` prefers Anthropic, then OpenCode Zen.
MODEL_PROVIDER=auto
ANTHROPIC_API_KEY=
# Active models: claude-sonnet-5-5 (recommended), claude-sonnet-4-6,
# claude-opus-4-8, or the cheaper claude-haiku-4-5-20251001. See
# https://docs.anthropic.com/en/docs/resources/model-deprecations
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1024
OPENCODE_API_KEY=

# --- Deploy behaviour --------------------------------------------------------
# Set to true once campaign.ojage.org and api.campaign.ojage.org resolve, so
# every deploy asserts that the public URLs actually answer.
VERIFY_PUBLIC=false