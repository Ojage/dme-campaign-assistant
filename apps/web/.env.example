# Copy to `.env.local` and adjust. Only VITE_* keys reach the browser bundle.

# Display name shown in the shell / document title.
VITE_APP_NAME="Campaign Assistant"

# Absolute URL of the API, used when the web app is served from a different
# origin than the API (a deployed frontend against a deployed API).
#
# Leave it unset in development: the dev server proxies /api to the API, so the
# browser sees one origin and no CORS preflight is involved. This is also the
# default in production when the API is reverse-proxied under the same host.
VITE_API_URL="http://localhost:4000/api"

# Where the dev server proxies /api during `pnpm dev:web`. The API runs on 4000
# in development; change this only if the API is on another port.
VITE_API_PROXY_TARGET="http://localhost:4000"

# Dev server ports.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173