# Copy to `.env.local` and adjust. Only VITE_* keys reach the browser bundle.

# Display name shown in the shell / document title.
VITE_APP_NAME="Campaign Assistant"

# Base URL of the live API. The app currently runs against the in-memory mock
# layer (src/data/mock) — swap the feature `api/` modules over to this URL.
VITE_API_BASE_URL="http://localhost:4000/api"

# Dev server ports.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
