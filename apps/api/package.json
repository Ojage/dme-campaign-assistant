{
  "name": "@dme/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Campaign Assistant API — hexagonal (ports & adapters) NestJS service.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsc -p tsconfig.seed.json && node dist-seed/database/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "clean": "rm -rf dist dist-seed *.tsbuildinfo",
    "build:seed": "tsc -p tsconfig.seed.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@dme/contracts": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "bcryptjs": "3.0.3",
    "dotenv": "17.2.4",
    "express": "5.1.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-dist": "^5.33.1",
    "typeorm": "1.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
