# API configuration. Copy to apps/api/.env and adjust.
NODE_ENV=development
PORT=4000
API_PREFIX=api

# The API is served on 4000 and the web app on 5173, so cross-origin requests are
# expected in development. Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Postgres. The API runs on the host while the database runs in Docker with the
# port published on 5433. The address is pinned to IPv4 because `localhost`
# resolves to ::1 first and Postgres only listens on 127.0.0.1.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=campaigns
DATABASE_USER=campaigns
DATABASE_PASSWORD=campaigns
# Only for managed TLS databases.
DATABASE_SSL=false

# Token lifetimes, in seconds.
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-9876543210
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Which model the API uses: auto | anthropic | opencode | scripted.
# `auto` picks Anthropic, then OpenCode Zen, then the deterministic local
# generator — so a key is the only step needed to change models. Naming a provider
# whose key is missing falls back to the local generator and says so at boot.
MODEL_PROVIDER=auto

# Anthropic, called on the native /messages route.
# Leave the key empty to rule the provider out.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024

# OpenCode Zen, called on the OpenAI-compatible /chat/completions route.
# Set the key to make this the provider when Anthropic has none. A key can be a
# real one or the free tier's placeholder, since Zen bills by provider.
# Leave the key empty to rule the provider out.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=glm-5.2
OPENCODE_MAX_TOKENS=1024

# With every key empty, `scripted` answers from local templates: no network, no
# cost, and the same text for the same request.
